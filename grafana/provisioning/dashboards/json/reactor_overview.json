    "panels": [
        {
            "collapsed": false,
            "gridPos": {
                "h": 10,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "title": "Live Process Trends (Readings Archive)",
            "type": "timeseries",
            "datasource": {
                "type": "postgres",
                "uid": "timescaledb"
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "timescaledb"
                    },
                    "format": "time_series",
                    "rawQuery": true,
                    "rawSql": "SELECT r.ts AS \"time\", r.value AS \"value\", t.name AS \"metric\" FROM readings r JOIN tags t ON r.tag_id = t.id WHERE $__timeFilter(r.ts) AND t.name IN ('R1.TEMP', 'R1.PRES', 'R1.AGIT', 'R2.TEMP', 'R3.TEMP') ORDER BY r.ts ASC;",
                    "refId": "A"
                }
            ]
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 10,
                "w": 12,
                "x": 0,
                "y": 10
            },
            "id": 2,
            "title": "Current Sensor Snapshots (1s Live Cache)",
            "type": "table",
            "datasource": {
                "type": "postgres",
                "uid": "timescaledb"
            },
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "timescaledb"
                    },
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT t.name AS \"Tag\", s.ts AS \"Last Updated\", ROUND(s.value::numeric, 2) AS \"Current Value\", t.units AS \"Units\", CASE s.quality WHEN 0 THEN 'Good' WHEN 1 THEN 'Questionable' WHEN 2 THEN 'Bad' WHEN 3 THEN 'Substituted' END AS \"Quality\" FROM snapshots s JOIN tags t ON s.tag_id = t.id ORDER BY t.id;",
                    "refId": "A"
                }
            ]
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 10,
                "w": 12,
                "x": 12,
                "y": 10
            },
            "id": 3,
            "title": "Recent Batch Phase Events",
            "type": "table",
            "datasource": {
                "type": "postgres",
                "uid": "timescaledb"
            },
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "timescaledb"
                    },
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT e.started_at AS \"Start\", COALESCE(e.ended_at, NOW()) AS \"End\", a.code AS \"Reactor\", COALESCE(b.batch_id, 'None') AS \"Batch\", e.name AS \"Phase\", e.occurrence AS \"Occurrence\" FROM events e JOIN assets a ON e.asset_id = a.id LEFT JOIN batches b ON e.batch_pk = b.id ORDER BY e.started_at DESC LIMIT 25;",
                    "refId": "A"
                }
            ]
        }
    ],
    "refresh": "5s",
    "schemaVersion": 39,
    "tags": [
        "reactor",
        "historian"
    ],
    "time": {
        "from": "now-1h",
        "to": "now"
