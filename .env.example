# ==============================================================================
# INDUSTRIAL PROCESS HISTORIAN - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust the values for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TimescaleDB / PostgreSQL Infrastructure
# ------------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=reactor
POSTGRES_PORT=5432

# Database connection URL for host-based development and local utility scripts
DATABASE_URL=postgres://admin:your_secure_db_password@localhost:5432/reactor

# ------------------------------------------------------------------------------
# 2. Core API Service (Port 4000)
# ------------------------------------------------------------------------------
PORT=4000
INTERNAL_UI_SECRET=generate_a_long_random_secret_for_ui_gateway
HEARTBEAT_INTERVAL_MIN=10
HEARTBEAT_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Integration Service (Port 4001) & Security
# ------------------------------------------------------------------------------
INTEGRATION_PORT=4001
API_KEY_EXTERNAL=your_external_api_key_for_clients
API_KEY_TEST=your_test_harness_api_key

# ------------------------------------------------------------------------------
# 4. Frontend Web Application (Port 80)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 5. Process Physics Simulator
# ------------------------------------------------------------------------------
AUTO_SEED_DAYS=3
SIMULATION_SPEED=1

# ------------------------------------------------------------------------------
# 6. BatchLine MES / Batch Execution System Integration
# ------------------------------------------------------------------------------
BATCHLINE_BASE_URL=https://your-batchline-instance.example.com
BATCHLINE_API_KEY=your_batchline_api_token
BATCHLINE_NOTIFICATION_URL=https://your-batchline-instance.example.com/Notification/push
MAX_PROFILE_SAMPLES=100
DEFAULT_PERIODIC_INTERVAL_MIN=1
MAX_PERIODIC_REPEATS=100
BATCHLINE_CHUNK_SIZE=50

# ------------------------------------------------------------------------------
# 7. Incident Notification & Webhook Dispatching (Make.com / Automation)
# ------------------------------------------------------------------------------
MAKE_HIGH_EXCEPTION_WEBHOOK_URL=https://hook.us2.make.com/your_webhook_id
x_make_apikey=your_make_api_key

# ------------------------------------------------------------------------------
# 8. External Ingress: Ngrok Tunnel (Dedicated to Webhooks / Integration Service)
# ------------------------------------------------------------------------------
NGROK_AUTHTOKEN_INTEGRATION=your_ngrok_auth_token
NGROK_DOMAIN_INTEGRATION=your-subdomain.ngrok-free.dev

# ------------------------------------------------------------------------------
# 9. Internal Ingress: Tailscale Funnel / Serve (Operator Web UI)
# ------------------------------------------------------------------------------
TS_AUTHKEY=tskey-auth-your_tailscale_key

# ------------------------------------------------------------------------------
# 10. Optional & Auxiliary Services
# ------------------------------------------------------------------------------
# Grafana (Optional analytics frontend)
GF_ID=admin
GF_pass=your_grafana_password

# Cloudflare Tunnel (Optional backup ingress)
CLOUDFLARE_TUNNEL_TOKEN=

